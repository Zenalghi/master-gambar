# =====================================================================
# DEVELOPMENT SECRETS - MASTER GAMBAR (TEMPLATE)
# =====================================================================
# INI ADALAH TEMPLATE - JANGAN PUSH KE GIT!
#
# Cara pakai:
#   1. Copy file ini: cp docker/.env.dev.secrets.example docker/.env.dev.secrets
#   2. Edit password: nano docker/.env.dev.secrets
#   3. Jalankan: docker compose -f docker-compose.dev.yml up -d --build
# =====================================================================

# MySQL Root Password (WAJIB DIISI!)
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_DI_SINI

# Database
MYSQL_DATABASE=db_master

# (Opsional) User selain root
MYSQL_USER=dev
MYSQL_PASSWORD=GANTI_PASSWORD_DEV_DI_SINI

# Laravel DB Connection (WAJIB - sesuaikan dengan MySQL di atas)
DB_CONNECTION=mysql
DB_HOST=mysql-dev
DB_PORT=3306
DB_DATABASE=db_master
DB_USERNAME=root
DB_PASSWORD=GANTI_PASSWORD_ROOT_DI_SINI

# Session & Cache (WAJIB file untuk development)
SESSION_DRIVER=file
CACHE_STORE=file

# Laravel
APP_NAME="Master Gambar Dev"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://192.168.100.173:8081
