# =====================================================================
# MySQL Custom Configuration
# Optimized for Laravel application with 30-50 concurrent users
# Heavy PDF/image processing workload
# =====================================================================

[mysqld]
# ---- Performance Settings ----
# innodb_buffer_pool_size: 50-70% of available RAM for MySQL
# With 2GB limit for MySQL container, use ~1.2GB
innodb_buffer_pool_size = 1280M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 8
innodb_write_io_threads = 8

# ---- Connection Settings ----
max_connections = 150
max_connect_errors = 100000
wait_timeout = 600
interactive_timeout = 600

# ---- Temp Tables ----
tmp_table_size = 128M
max_heap_table_size = 128M

# ---- Table Settings ----
table_open_cache = 4000
table_definition_cache = 2000

# ---- Logging ----
slow_query_log = 1
long_query_time = 2

# ---- Character Set ----
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ---- Security ----
local_infile = 0

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4