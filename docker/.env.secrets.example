# =====================================================================
# MASTER GAMBAR - SECRETS CONFIGURATION TEMPLATE
# =====================================================================
# File ini adalah TEMPLATE - Aman untuk di-commit ke Git!
#
# Cara setup:
#   1. Copy template: cp docker/.env.secrets.example docker/.env.secrets
#   2. Edit password: nano docker/.env.secrets
#   3. File .env.secrets akan otomatis di-ignore oleh Git
#
# File ini akan di-load oleh:
#   - docker/update-safe.sh
#   - docker/mysql/backup.sh
#   - docker/setup-autostart.sh
# =====================================================================

# MySQL Root Password (sama dengan root_password di docker-compose.prod.yml)
# Ganti dengan password root MySQL Anda
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_DI_SINI

# MySQL App Password (sama dengan app_password di docker-compose.prod.yml)
# Ganti dengan password app MySQL Anda
MYSQL_APP_PASSWORD=GANTI_PASSWORD_APP_DI_SINI

# Database Name
MYSQL_DATABASE=db_master

# Backup Configuration
BACKUP_DIR=/mnt/data/backups
RETENTION_DAYS=7
