# =====================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES - TEMPLATE
# =====================================================================
# Cara pakai:
#   1. Copy file ini:       cp docker/.env.dev.example docker/.env.dev
#   2. Edit password saja:  nano docker/.env.dev
#   3. Jalankan:            docker compose -f docker-compose.dev.yml up -d --build
#
# File docker/.env.dev TIDAK masuk Git (sudah di .gitignore)
# =====================================================================

APP_NAME="Master Gambar Dev"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://192.168.100.173:

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=
BCRYPT_ROUNDS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql-dev
DB_PORT=
DB_DATABASE=db_master_dev
DB_USERNAME=dev
DB_PASSWORD=CHANGE_ME_DEV_PASSWORD

# MySQL Root Password (sama dengan yang di docker-compose.dev.yml)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="dev@master-gambar.local"
MAIL_FROM_NAME="${APP_NAME}"
