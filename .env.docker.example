APP_NAME="Master Gambar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://<IP_SERVER_ANDA>:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_master
DB_USERNAME=app
DB_PASSWORD=<PASSWORD_USER_MYSQL>

MYSQL_ROOT_PASSWORD=<PASSWORD_ROOT_MYSQL>
MYSQL_PASSWORD=<PASSWORD_USER_MYSQL>
MYSQL_USER=app
MYSQL_DATABASE=db_master
APP_PORT=8080
MYSQL_PORT=3307